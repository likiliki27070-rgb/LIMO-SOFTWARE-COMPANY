# ==============================================================================
# LIMO PLATFORM — ROOT GITIGNORE
# Prevents committing secrets, dependencies, and build artifacts
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
/.pnp
.pnp.*

# Build artifacts & caches
*/.next/
*/.expo/
*/dist/
*/build/
*/out/
*/web-build/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# Native builds
*/android/
*/ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets & Environment files (NEVER commit live keys)
.env
.env.*
!.env.example
!*/.env.example
*.env
*.env.local

# Testing & Coverage
coverage/
*/coverage/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & Editor
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
