# ==============================================================================
# LIMO MOBILE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local for local overrides.
# DO NOT COMMIT PRIVATE SERVICE-ROLE KEYS OR PRODUCTION SECRETS.
# ==============================================================================

# Supabase Project Configuration (Free Tier Compatible)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Environment Mode (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# OTP & Phone Verification Provider Mode
# Set to 'demo' for instant development OTP verification codes
# Set to 'supabase_twilio' or 'firebase' when SMS provider is configured
EXPO_PUBLIC_OTP_MODE=demo
EXPO_PUBLIC_OTP_EXPIRY_SECONDS=300
EXPO_PUBLIC_OTP_RESEND_COOLDOWN_SECONDS=60
EXPO_PUBLIC_OTP_MAX_ATTEMPTS=5

# Payment & Escrow Mode
# 'sandbox' enables local auditable ledger and escrow simulation
# 'stripe' requires server-side payment intent endpoints
EXPO_PUBLIC_PAYMENT_MODE=sandbox

# Sentry / Error Monitoring (Optional for production)
EXPO_PUBLIC_SENTRY_DSN=
